  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Required by the source-generated P/Invoke declarations (LibraryImport). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Haul</RootNamespace>
    <AssemblyName>Haul</AssemblyName>
    <ApplicationIcon>..\..\icono\Haul.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.6.0</Version>
    <!-- Plain "1.1.0" in Settings > Apps, without the git commit the SDK appends by default. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Haul</Product>
    <Company>Gabriel Castiglia</Company>
    <Authors>Gabriel Castiglia</Authors>
    <Copyright>Copyright (C) 2026 Gabriel Castiglia. GPL-2.0-only.</Copyright>
    <Description>Graphical front end for yt-dlp</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Application.ThemeMode (the Windows 11 Fluent theme) is still flagged as experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- The bundled yt-dlp version is read from vendor/yt-dlp/VERSION and stored in the assembly. -->
    <YtDlpVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\vendor\yt-dlp\VERSION').Trim())</YtDlpVersion>
    <!-- Debug data names source files from the repository root (/_/), not from the folder where it was built. -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))=/_/</PathMap>
  </PropertyGroup>

  <!-- "dotnet publish -c Release" produces a single self-contained Haul.exe (no .NET install required);
       yt-dlp.exe, the plugins and the licenses stay next to it as separate files. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="YtDlpVersion" Value="$(YtDlpVersion)" />
    <Resource Include="..\..\icono\accents\*.ico" Link="Recursos\accents\%(Filename)%(Extension)" />
    <None Include="..\..\vendor\yt-dlp\yt-dlp.exe" Link="yt-dlp.exe"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\vendor\yt-dlp\licenses\*" Link="licenses\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\plugins\**\*.py" Link="plugins\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\LICENSE" Link="licenses\Haul-LICENSE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
