<Window x:Class="Haul.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Haul.Core"
        Title="Haul" Width="640" Height="800" MinWidth="560" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Recursos/icono-256.png">

    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{x:Static core:Comandos.Descargar}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static core:Comandos.Descargar}" Executed="Descargar_Click" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Decorative glow behind the header. -->
        <Border Grid.RowSpan="3" Height="220" VerticalAlignment="Top" Margin="0,-90,0,0" Opacity="0.22"
                Background="{DynamicResource DegradeBrush}" IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="90" />
            </Border.Effect>
        </Border>

        <!-- Header: fixed, like everything down to the Download button; only the queue scrolls -->
        <Grid Grid.Row="0" Margin="28,18,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="52" Height="52" Source="pack://application:,,,/Recursos/icono-256.png"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.35" />
                </Image.Effect>
            </Image>
            <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Text="Haul" FontSize="28" FontWeight="Bold" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Glifo}" FontSize="14" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="&#xE774;" />
                <ComboBox x:Name="SelectorIdioma" MinWidth="118" SelectionChanged="Idioma_Changed">
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="Español" />
                </ComboBox>
                <Button x:Name="BotonAcercaDe" Margin="8,0,0,0" Padding="9,6" Click="AcercaDe_Click">
                    <TextBlock Style="{StaticResource Glifo}" FontSize="14" Text="&#xE946;" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="28,0,28,0">

                <!-- Missing tools -->
                <Border x:Name="AvisoFaltantes" Style="{StaticResource Tarjeta}" Margin="0,0,0,18" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glifo}" Foreground="DarkOrange" Text="&#xE7BA;" />
                        <TextBlock x:Name="TextoFaltantes" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="500" />
                    </StackPanel>
                </Border>

                <!-- Links -->
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glifo}" VerticalAlignment="Top" Margin="0,8,10,0"
                                       Foreground="{DynamicResource AcentoBrush}" Text="&#xE71B;" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="CampoEnlaces" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                                         IsEnabled="{Binding CampoHabilitado}"
                                         VerticalScrollBarVisibility="Auto" FontSize="14"
                                         Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock x:Name="Sugerencia" Margin="12,8,0,0" FontSize="14" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding TextoVacio, Converter={StaticResource BoolAVisible}}" />
                            </Grid>
                        </Grid>
                        <DockPanel Margin="0,10,0,0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextoSecundario}" VerticalAlignment="Center"
                                       Text="{Binding Contador}" />
                            <Button x:Name="BotonPegar" DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0" Click="Pegar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glifo}" FontSize="13" Text="&#xE77F;" />
                                    <TextBlock x:Name="TextoPegar" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BotonBorrar" DockPanel.Dock="Right" Padding="10,4" Click="Borrar_Click" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Format -->
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <RadioButton x:Name="OpcionVideo" Style="{StaticResource BotonFormato}" Tag="&#xE714;" Margin="0,0,6,0"
                                 GroupName="Formato" Checked="Formato_Checked">
                        <StackPanel>
                            <TextBlock x:Name="TituloVideo" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="DetalleVideo" Style="{StaticResource TextoSecundario}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="OpcionAudio" Style="{StaticResource BotonFormato}" Tag="&#xEC4F;" Margin="6,0,0,0"
                                 GroupName="Formato" Checked="Formato_Checked">
                        <StackPanel>
                            <TextBlock x:Name="TituloAudio" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="DetalleAudio" Style="{StaticResource TextoSecundario}" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
                <!-- Kept out of the queue section, which hides itself once the list is empty -->
                <Grid Margin="2,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="OpcionListaEntera" IsChecked="{Binding ListaEntera}" />
                    <CheckBox x:Name="OpcionInstrumentales" Grid.Column="1" IsChecked="{Binding Instrumentales}" />
                    <CheckBox x:Name="OpcionLimpiar" Grid.Row="1" Grid.ColumnSpan="2" IsChecked="{Binding LimpiarSola}" />
                </Grid>

                <!-- Destination -->
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glifo}" Foreground="{DynamicResource AcentoBrush}" Text="&#xE8B7;" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TextoGuardarEn" Style="{StaticResource TextoSecundario}" />
                            <TextBlock FontSize="14" FontWeight="Medium" Text="{Binding NombreDestino}"
                                       ToolTip="{Binding Destino}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="BotonCambiar" Grid.Column="2" Padding="12,5" Margin="8,0,0,0" Click="Cambiar_Click" />
                        <Button x:Name="BotonAbrirCarpeta" Grid.Column="3" Padding="9,5" Margin="8,0,0,0" Click="AbrirCarpeta_Click">
                            <TextBlock Style="{StaticResource Glifo}" FontSize="13" Text="&#xE8A7;" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Main action -->
                <Button x:Name="BotonDescargar" Style="{StaticResource BotonGrande}" Margin="0,0,0,14"
                        IsEnabled="{Binding PuedeDescargar}" Click="Descargar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glifo}" Foreground="White" FontSize="16" Text="&#xE896;" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding TituloDelBoton}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
        </StackPanel>

        <ScrollViewer x:Name="Desplazador" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PreviewDragOver="Desplazador_DragOver">
            <StackPanel Margin="28,4,28,24">

                <!-- Question card: playlists are asked about here, not in a separate dialog -->
                <Border x:Name="TarjetaPregunta" Style="{StaticResource Tarjeta}" Margin="0,0,0,18" BorderThickness="1.5"
                        BorderBrush="{DynamicResource DegradeBrush}"
                        Visibility="{Binding HayPregunta, Converter={StaticResource BoolAVisible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="9" VerticalAlignment="Top"
                                Background="{DynamicResource DegradeBrush}">
                            <TextBlock Style="{StaticResource Glifo}" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" Text="{Binding IconoPregunta}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{Binding TituloPregunta}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TextoPregunta}" Style="{StaticResource TextoSecundario}" FontSize="13"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding DetallePregunta}" Style="{StaticResource TextoTerciario}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                       Visibility="{Binding HayDetallePregunta, Converter={StaticResource BoolAVisible}}" />
                            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                                <Button DockPanel.Dock="Left" Padding="14,6" Content="{Binding TextoCancelar}"
                                        Click="PreguntaCancelar_Click" />
                                <Button DockPanel.Dock="Right" Padding="14,6" Margin="8,0,0,0" Content="{Binding TextoPrincipal}"
                                        Style="{DynamicResource AccentButtonStyle}" Click="PreguntaPrincipal_Click" />
                                <Button DockPanel.Dock="Right" Padding="14,6" Content="{Binding TextoSecundario}"
                                        Click="PreguntaSecundaria_Click"
                                        Visibility="{Binding HaySecundario, Converter={StaticResource BoolAVisible}}" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Queue -->
                <StackPanel x:Name="SeccionCola" Margin="0,0,0,18"
                            Visibility="{Binding HayElementos, Converter={StaticResource BoolAVisible}}">
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock x:Name="TituloCola" DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Left" Margin="10,2,0,0" Style="{StaticResource TextoSecundario}"
                                   FontSize="13" Text="{Binding Resumen}" />
                        <Button x:Name="BotonCancelarTodo" DockPanel.Dock="Right" Padding="10,3" Margin="6,0,0,0"
                                Click="CancelarTodo_Click"
                                Visibility="{Binding MostrarCancelarTodo, Converter={StaticResource BoolAVisible}}" />
                        <Button x:Name="BotonSeguirTodo" DockPanel.Dock="Right" Padding="10,3" Margin="6,0,0,0"
                                Click="SeguirTodo_Click"
                                Visibility="{Binding MostrarSeguirTodo, Converter={StaticResource BoolAVisible}}" />
                        <Button x:Name="BotonPausarTodo" DockPanel.Dock="Right" Padding="10,3" Margin="6,0,0,0"
                                Click="PausarTodo_Click"
                                Visibility="{Binding MostrarPausarTodo, Converter={StaticResource BoolAVisible}}" />
                        <Button x:Name="BotonReintentarTodas" DockPanel.Dock="Right" Padding="10,3" Margin="6,0,0,0"
                                Click="ReintentarTodas_Click"
                                Visibility="{Binding HayFallos, Converter={StaticResource BoolAVisible}}" />
                    </DockPanel>
                    <!-- Rows can be dragged to another place; downloads start in list order -->
                    <ItemsControl ItemsSource="{Binding Elementos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:Elemento}">
                                <Border Style="{StaticResource Tarjeta}" Padding="12" Margin="0,0,0,10" AllowDrop="True"
                                        PreviewMouseLeftButtonDown="Fila_MouseDown" PreviewMouseMove="Fila_MouseMove"
                                        DragOver="Fila_DragOver" Drop="Fila_Drop">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail, with a placeholder while it loads -->
                                        <Border Width="112" Height="63" CornerRadius="9" ClipToBounds="True"
                                                Opacity="{Binding Opacidad}" VerticalAlignment="Center">
                                            <Grid>
                                                <Border CornerRadius="9" Background="{DynamicResource DegradeBrush}" Opacity="0.25" />
                                                <TextBlock Style="{StaticResource Glifo}" FontSize="20" Foreground="White"
                                                           HorizontalAlignment="Center" Text="&#xE768;" Opacity="0.85" />
                                                <Border CornerRadius="9">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Imagen}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Ubicacion}" Style="{StaticResource TextoTerciario}" Margin="0,2,0,0"
                                                       Visibility="{Binding TieneUbicacion, Converter={StaticResource BoolAVisible}}" />
                                            <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="1"
                                                         Value="{Binding Progreso, Mode=OneWay}"
                                                         Foreground="{DynamicResource DegradeBrush}"
                                                         Visibility="{Binding MostrarBarra, Converter={StaticResource BoolAVisible}}" />
                                            <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="True" Width="80"
                                                         HorizontalAlignment="Left"
                                                         Visibility="{Binding MostrarEspera, Converter={StaticResource BoolAVisible}}" />
                                            <TextBlock Text="{Binding TextoDeEstado}" Margin="0,4,0,0"
                                                       FontSize="12" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsError}" Value="True">
                                                                <Setter Property="Foreground" Value="#E5484D" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource BotonIcono}" Content="&#xE769;"
                                                    ToolTip="{Binding AyudaPausar}" AutomationProperties.Name="{Binding AyudaPausar}"
                                                    Click="PausarFila_Click"
                                                    Visibility="{Binding PuedePausar, Converter={StaticResource BoolAVisible}}" />
                                            <Button Style="{StaticResource BotonIcono}" Content="&#xE768;" Foreground="{DynamicResource AcentoBrush}"
                                                    ToolTip="{Binding AyudaReanudar}" AutomationProperties.Name="{Binding AyudaReanudar}"
                                                    Click="ReanudarFila_Click"
                                                    Visibility="{Binding PuedeReanudar, Converter={StaticResource BoolAVisible}}" />
                                            <Button Style="{StaticResource BotonIcono}" Content="&#xE711;" ToolTip="{Binding AyudaCancelar}" AutomationProperties.Name="{Binding AyudaCancelar}"
                                                    Click="CancelarFila_Click"
                                                    Visibility="{Binding PuedeCancelar, Converter={StaticResource BoolAVisible}}" />
                                            <Button Style="{StaticResource BotonIcono}" Content="&#xE8B7;"
                                                    ToolTip="{Binding AyudaMostrar}" AutomationProperties.Name="{Binding AyudaMostrar}"
                                                    Click="MostrarFila_Click"
                                                    Visibility="{Binding PuedeAbrir, Converter={StaticResource BoolAVisible}}" />
                                            <Button Style="{StaticResource BotonIcono}" Content="&#xE768;" Foreground="{DynamicResource AcentoBrush}"
                                                    ToolTip="{Binding AyudaAbrir}" AutomationProperties.Name="{Binding AyudaAbrir}"
                                                    Click="AbrirFila_Click"
                                                    Visibility="{Binding PuedeAbrir, Converter={StaticResource BoolAVisible}}" />
                                            <TextBlock Style="{StaticResource Glifo}" Foreground="#2EA043" Text="&#xE73E;" Margin="6,0"
                                                       Visibility="{Binding ListoSinArchivo, Converter={StaticResource BoolAVisible}}" />
                                            <Button Style="{StaticResource BotonIcono}" Content="{Binding IconoReintentar}" Foreground="{DynamicResource AcentoBrush}"
                                                    ToolTip="{Binding AyudaReintentar}" AutomationProperties.Name="{Binding AyudaReintentar}"
                                                    Click="ReintentarFila_Click"
                                                    Visibility="{Binding PuedeReintentar, Converter={StaticResource BoolAVisible}}" />
                                            <Button Style="{StaticResource BotonIcono}" Content="&#xE711;" ToolTip="{Binding AyudaQuitar}" AutomationProperties.Name="{Binding AyudaQuitar}"
                                                    Click="QuitarFila_Click"
                                                    Visibility="{Binding PuedeQuitar, Converter={StaticResource BoolAVisible}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock x:Name="Pie" Style="{StaticResource TextoTerciario}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
