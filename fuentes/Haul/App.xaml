<Application x:Class="Haul.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Accent brushes. Acento.cs fills them from the Windows accent color and refreshes
                 them when it changes; these values are only the fallback. -->
            <Color x:Key="AcentoColor">#1E8E45</Color>
            <SolidColorBrush x:Key="AcentoBrush" Color="#1E8E45" />
            <SolidColorBrush x:Key="AcentoSuaveBrush" Color="#401E8E45" />
            <LinearGradientBrush x:Key="DegradeBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#1E8E45" />
                <GradientStop Offset="1" Color="#145C2D" />
            </LinearGradientBrush>

            <FontFamily x:Key="Iconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="Monoespaciada">Cascadia Mono, Consolas</FontFamily>

            <!-- Rounded card, the building block of the window. -->
            <Style x:Key="Tarjeta" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            </Style>

            <Style x:Key="TextoSecundario" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="TextoTerciario" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="Glifo" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Iconos}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Format selector: a radio button drawn as a card with an icon tile. -->
            <Style x:Key="BotonFormato" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Marco" CornerRadius="12" BorderThickness="1" Padding="10"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Azulejo" Width="38" Height="38" CornerRadius="9"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock x:Name="Icono" Style="{StaticResource Glifo}" FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AcentoBrush}"
                                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Border>
                                    <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Marco" Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource DegradeBrush}" />
                                    <Setter TargetName="Marco" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="Marco" Property="Padding" Value="9" />
                                    <Setter TargetName="Marco" Property="Background" Value="Transparent" />
                                    <Setter TargetName="Azulejo" Property="Background" Value="{DynamicResource DegradeBrush}" />
                                    <Setter TargetName="Icono" Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Main action: a pill filled with the accent gradient. -->
            <Style x:Key="BotonGrande" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Pastilla" CornerRadius="22" Padding="0,12"
                                    Background="{DynamicResource DegradeBrush}">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="Sombra" BlurRadius="12" ShadowDepth="3" Opacity="0.3"
                                                      Color="{DynamicResource AcentoColor}" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Pastilla" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                    <Setter TargetName="Pastilla" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.01" ScaleY="1.01" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Pastilla" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small borderless icon button used in the queue rows. -->
            <Style x:Key="BotonIcono" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontFamily" Value="{StaticResource Iconos}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fondo" CornerRadius="6" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fondo" Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolAVisible" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
