<!-- WiX Toolset 5 bundle that contains the MSI and the setup window. See scripts\build.ps1. -->
<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>haul-setup</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>MsiPath=$(MsiPath);SetupUiDir=$(SetupUiDir);Version=$(Version)</DefineConstants>
  </PropertyGroup>
</Project>
