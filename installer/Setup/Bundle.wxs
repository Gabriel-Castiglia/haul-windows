<!--
  haul-setup.exe: a WiX bundle that installs the MSI with Haul's own setup window (installer\SetupUI),
  in English or Spanish, chosen from a menu. The same window opens to uninstall from "Installed apps".
  Installing a newer version upgrades the old one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Bundle Name="Haul"
          Manufacturer="Gabriel Castiglia"
          Copyright="Copyright (C) 2026 Gabriel Castiglia. Licensed under the GNU GPL, version 2 only."
          Version="$(var.Version)"
          UpgradeCode="e88d432e-6295-42e2-ae13-948e56f3c5f6"
          IconSourceFile="..\..\icono\Haul.ico"
          AboutUrl="https://github.com/Gabriel-Castiglia/haul-windows"
          DisableModify="yes">
    <!-- The setup window: a .NET Framework 4.7.2 program, which Windows 10 and 11 already include. -->
    <BootstrapperApplication SourceFile="$(var.SetupUiDir)HaulSetup.exe">
      <Payload SourceFile="$(var.SetupUiDir)HaulSetup.exe.config" />
      <Payload SourceFile="$(var.SetupUiDir)WixToolset.BootstrapperApplicationApi.dll" />
      <Payload SourceFile="$(var.SetupUiDir)mbanative.dll" />
    </BootstrapperApplication>

    <!-- Interface language chosen in the setup window; handed to the MSI, which stores it for the app. -->
    <Variable Name="HaulLanguage" Value="en" />

    <Chain>
      <MsiPackage Id="HaulMsi" SourceFile="$(var.MsiPath)">
        <MsiProperty Name="HAULLANGUAGE" Value="[HaulLanguage]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
